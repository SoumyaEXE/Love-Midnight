# Copy to .env. Both are gitignored.
#
# The prefix is the security boundary, not a naming convention: Metro inlines
# every EXPO_PUBLIC_ variable into the client bundle, so only put things there
# that are safe to hand to anyone who unzips the app.

# Basemap key. Public by construction - it rides on every tile request.
# Without one, CARTO watermarks the tiles with "API KEY REQUIRED".
# Free, no account needed, 5M tiles/month: https://carto.com/basemaps/apikey/
EXPO_PUBLIC_CARTO_API_KEY=

# CARTO platform access token, for the Maps API v3 at gcp-us-east1.api.carto.com.
# NOT public: this authenticates to the CARTO account and can read its data
# warehouse connections. Deliberately has no EXPO_PUBLIC_ prefix so it cannot
# reach the bundle. Nothing in the app reads it today.
CARTO_ACCESS_TOKEN=
