# Copy to .env. That copy is gitignored; this template is committed.
#
# The prefix is the security boundary, not a naming convention: Metro inlines
# every EXPO_PUBLIC_ variable into the client bundle, so only put things there
# that are safe to hand to anyone who unzips the app.
#
# The CARTO block is optional - app.json carries a committed basemap key behind
# it. The Firebase block is not: those values have no fallback in source, and a
# build without them fails at startup naming the variables it wanted.
#
# Env values are inlined at build time. After editing .env, restart Metro with
# `npx expo start --clear` or the running bundler will serve the old ones.

# Basemap key. Public by construction - it rides on every tile request.
# Without one, CARTO watermarks the tiles with "API KEY REQUIRED".
# Free, no account needed, 5M tiles/month: https://carto.com/basemaps/apikey/
EXPO_PUBLIC_CARTO_API_KEY=

# CARTO platform access token, for the Maps API v3 at gcp-us-east1.api.carto.com.
# NOT public: this authenticates to the CARTO account and can read its data
# warehouse connections. Deliberately has no EXPO_PUBLIC_ prefix so it cannot
# reach the bundle. Nothing in the app reads it today.
CARTO_ACCESS_TOKEN=

# --- Firebase -----------------------------------------------------------------
#
# A Firebase web config is public by construction. The SDK sends these on every
# request, so they are extractable from any build no matter where they are
# written down - which is why they carry EXPO_PUBLIC_ rather than being hidden.
# They identify the project; they do not grant access to it. Access is decided
# by database.rules.json and the anonymous session behind it.
#
# They live here so the project can be swapped without touching source, and so
# nothing about which project a build points at is decided by a literal someone
# edited once. Take them from Project settings -> Your apps -> SDK setup.

# Required - the SDK cannot be constructed without these five.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Also required. The console's web snippet sometimes omits it, because Realtime
# Database is provisioned separately - copy it from the top of the Realtime
# Database page.
#   us-central1:  https://<project>-default-rtdb.firebaseio.com
#   elsewhere:    https://<project>-default-rtdb.<region>.firebasedatabase.app
EXPO_PUBLIC_FIREBASE_DATABASE_URL=

# Optional. Nothing here uses Storage, and Analytics has been optional since
# JS SDK v7.20 - it is web-only and never runs on a handset.
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=
