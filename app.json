{
  "expo": {
    "name": "Halo",
    "slug": "halo-midnight",
    "scheme": "halo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#07060A",
    "splash": {
      "backgroundColor": "#07060A",
      "resizeMode": "contain",
      "image": "./assets/splash-icon.png"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.automass.halo",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Halo proves you are near someone without ever sending your coordinates off this device.",
        "NSCameraUsageDescription": "Halo asks for three photos of your face so a reviewer can confirm you are a real person. They are never shown on your card.",
        "UIViewControllerBasedStatusBarAppearance": true
      }
    },
    "android": {
      "package": "in.automass.halo",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#07060A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Halo proves you are near someone without ever sending your coordinates off this device."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Halo asks for three photos of your face so a reviewer can confirm you are a real person. They are never shown on your card.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "midnightIndexer": "https://indexer.testnet-02.midnight.network/api/v1/graphql",
      "midnightProofServer": "http://127.0.0.1:6300",
      "midnightNode": "https://rpc.testnet-02.midnight.network",
      "proximityContract": null,
      "matchContract": null,
      "credentialContract": null,
      "solanaCluster": "https://api.devnet.solana.com",
      "solanaProgram": "MemoSq4gqABAXKb96qnH8TysNcWxMyWCqXgDLGmfcHr",
      "cartoApiBase": "https://gcp-us-east1.api.carto.com",
      "cartoBasemap": "dark_all",
      "cartoBasemapKey": "cb1_2j57_1_8b63520ddf7c032cbb51d04a"
    }
  }
}
