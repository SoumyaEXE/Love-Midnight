pragma language_version 0.16;

import CompactStandardLibrary;

// -----------------------------------------------------------------------------
// Halo :: match
//
// The AI-track circuit. It answers a question a recommender normally cannot:
// "the model scored us compatible - prove it followed the rules."
//
// Halo's matcher is a fixed-weight scorer over a 16-dimension interest vector.
// It runs entirely on the handset. The vector is the single most sensitive
// thing the app holds - sexuality, health, politics, religion all live in it -
// and it never leaves the device, encrypted or otherwise.
//
// What leaves the device is this proof, which establishes:
//
//   1. both interest vectors open their published commitments
//   2. the score is the correct dot product of those vectors under the
//      *committed* weight set - the model cannot be swapped for one that
//      favours a paying advertiser
//   3. the score clears the threshold both parties independently agreed to
//   4. every dimension flagged private by either side contributed zero
//
// Point 4 is the part a server-side recommender can never offer. A user can
// mark "health" or "politics" private, and the proof shows the model was
// structurally unable to read those dimensions - not that it promised not to.
//
// Only a coarse 0-4 score band is disclosed. The exact score would leak the
// vector under repeated queries against attacker-chosen profiles.
// -----------------------------------------------------------------------------

const DIMENSIONS: Uint<8> = 16;

/// Fixed-point scale. Interest weights are integers in [0, 1000].
const SCALE: Uint<64> = 1000;

/// Score axis. A normalised score runs 0..AXIS.
const AXIS: Uint<64> = 10000;

/// Score bands, as a share of achievable overlap. Disclosing a band rather
/// than a score bounds what an attacker learns per query to ~2 bits.
const BAND_1: Uint<64> = 2000;
const BAND_2: Uint<64> = 4000;
const BAND_3: Uint<64> = 6000;
const BAND_4: Uint<64> = 8000;

/// Hash of the weight vector the network has agreed to score with. Governance
/// rotates this; clients refuse to prove against an unrecognised model.
export ledger activeModel: Bytes<32>;

/// Mutual matches, keyed by nullifier, valued by disclosed band.
export ledger matches: Map<Bytes<32>, Uint<8>>;

export ledger epoch: Counter;

/// The prover's own interest vector and its blinding factor.
witness localVector(): Vector<16, Uint<32>>;
witness localSalt(): Bytes<32>;

/// The peer's vector, received over the pairing channel after both sides opted
/// in. Still forced to open the peer's public commitment below.
witness peerVector(): Vector<16, Uint<32>>;
witness peerSalt(): Bytes<32>;

/// The model weights. Public in principle, passed as a witness so the circuit
/// can hash them and compare against `activeModel` in one pass.
witness modelWeights(): Vector<16, Uint<32>>;

/// Per-dimension consent masks. 1 = this dimension may be scored, 0 = it is
/// withheld. The union of both masks is what actually gets used, so a single
/// "no" from either side is enough to zero a dimension.
witness localMask(): Vector<16, Uint<8>>;
witness peerMask(): Vector<16, Uint<8>>;

circuit vectorCommitment(v: Vector<16, Uint<32>>, salt: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "halo:vec:v1"),
    salt,
    persistentHash<Vector<16, Uint<32>>>(v)
  ]);
}

circuit modelCommitment(w: Vector<16, Uint<32>>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "halo:model:v1"),
    persistentHash<Vector<16, Uint<32>>>(w)
  ]);
}

/// Bands from a raw/denominator pair, without ever dividing.
///
/// `raw * AXIS >= BAND_k * denom` is exactly `raw * AXIS / denom >= BAND_k`
/// for positive denom, so cross-multiplying gives the same answer as the
/// TypeScript scorer while keeping the circuit free of division - which is
/// both expensive in constraints and a source of off-by-one disagreements at
/// band boundaries.
circuit bandOf(raw: Uint<64>, denom: Uint<64>): Uint<8> {
  if (denom == 0) { return 0 as Uint<8>; }

  const scaled = raw * AXIS;
  if (scaled < BAND_1 * denom) { return 0 as Uint<8>; }
  if (scaled < BAND_2 * denom) { return 1 as Uint<8>; }
  if (scaled < BAND_3 * denom) { return 2 as Uint<8>; }
  if (scaled < BAND_4 * denom) { return 3 as Uint<8>; }
  return 4 as Uint<8>;
}

circuit matchNullifier(
  commitA: Bytes<32>,
  commitB: Bytes<32>,
  ep: Uint<64>
): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "halo:match-null:v1"),
    commitA,
    commitB,
    persistentHash<Uint<64>>(ep)
  ]);
}

/// The scorer itself, expressed as constraints rather than executed code.
///
///   raw   = sum_i  a_i * b_i * w_i * consent_i
///   denom = sum_i  w_i * consent_i * max(a_i, b_i) * SCALE
///
/// and the normalised score is raw * AXIS / denom, which `bandOf` evaluates by
/// cross-multiplication rather than division.
///
/// Two design points are load-bearing.
///
/// The mask multiply enforces the consent guarantee: a withheld dimension is
/// multiplied by zero, so no arrangement of witnesses can make it contribute.
///
/// The denominator carries the *same* consent term as the numerator, and only
/// accumulates where at least one party has signal. That means closing a
/// dimension removes it from both sides of the ratio, so withholding can never
/// lower your band - and dimensions neither party cares about cannot dilute a
/// genuine match toward zero. An unnormalised dot product has neither property.
///
/// Returns (raw, denom) so the caller can band it without a division.
circuit compatibility(
  a: Vector<16, Uint<32>>,
  b: Vector<16, Uint<32>>,
  w: Vector<16, Uint<32>>,
  maskA: Vector<16, Uint<8>>,
  maskB: Vector<16, Uint<8>>
): [Uint<64>, Uint<64>] {
  let raw = 0 as Uint<64>;
  let denom = 0 as Uint<64>;

  for (const i of 0..16) {
    assert(a[i] <= SCALE, "match: local weight out of range");
    assert(b[i] <= SCALE, "match: peer weight out of range");
    assert(w[i] <= SCALE, "match: model weight out of range");
    assert(maskA[i] <= 1, "match: local mask not boolean");
    assert(maskB[i] <= 1, "match: peer mask not boolean");

    // Both sides must consent for a dimension to count.
    const consent = (maskA[i] * maskB[i]) as Uint<64>;
    const ai = a[i] as Uint<64>;
    const bi = b[i] as Uint<64>;
    const wi = w[i] as Uint<64>;

    raw = raw + (ai * bi * wi * consent);

    const peak = ai > bi ? ai : bi;
    denom = denom + (wi * consent * peak * SCALE);
  }

  // Bounds: raw <= 16 * 1000^3 = 1.6e10, and bandOf multiplies by AXIS to
  // 1.6e14 - comfortably inside 64 bits, with the same headroom on denom.
  return [raw, denom];
}

/// Prove a mutual match and publish only the band.
///
/// Public inputs:  commitA, commitB, threshold band
/// Disclosed:      the achieved band
/// Hidden:         both interest vectors, the exact score, both consent masks
export circuit proveMatch(
  commitA: Bytes<32>,
  commitB: Bytes<32>,
  minBand: Uint<8>
): Uint<8> {
  const a = localVector();
  const saltA = localSalt();
  const b = peerVector();
  const saltB = peerSalt();
  const w = modelWeights();

  // 1. Vectors must open their published commitments.
  assert(vectorCommitment(a, saltA) == commitA, "match: bad local opening");
  assert(vectorCommitment(b, saltB) == commitB, "match: bad peer opening");

  // 2. The model must be the one the network sanctioned. This is the clause
  //    that makes "the model followed the rules" checkable rather than trusted.
  assert(modelCommitment(w) == activeModel, "match: unsanctioned model");

  // 3. Score under both consent masks.
  const [raw, denom] = compatibility(a, b, w, localMask(), peerMask());
  const band = bandOf(raw, denom);
  assert(band >= minBand, "match: below agreed threshold");

  // 4. One match per pair per epoch.
  const nul = matchNullifier(commitA, commitB, epoch);
  assert(!matches.member(nul), "match: already matched this epoch");
  matches.insert(nul, disclose(band));

  return band;
}

/// Governance: rotate the sanctioned model. In production this sits behind the
/// network's multisig; the demo deployment leaves it open.
export circuit setModel(commitment: Bytes<32>): [] {
  activeModel = disclose(commitment);
}
