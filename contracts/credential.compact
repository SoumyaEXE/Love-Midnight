pragma language_version 0.16;

import CompactStandardLibrary;

// -----------------------------------------------------------------------------
// Halo :: credential
//
// Age and personhood gating without an identity document ever touching the app.
//
// The user holds an issuer-signed credential in the wallet: (birthYear, issuer,
// subject, salt). Halo never sees it. What Halo sees is a proof that some
// credential, signed by an issuer on the accepted list, attests the holder is
// over 18 - and a nullifier that stops one credential from minting an unbounded
// number of profiles.
//
// The nullifier is the interesting half. Deriving it from the credential
// subject and a per-app domain gives Halo exactly one persistent handle per
// real person, so bans and rate limits work, while the same credential yields a
// completely unlinkable handle in any other app.
// -----------------------------------------------------------------------------

const MIN_AGE: Uint<16> = 18;

/// Issuers whose attestations are accepted. Keyed by issuer public key hash.
export ledger trustedIssuers: Set<Bytes<32>>;

/// One entry per personhood-gated account. Value is the epoch it was minted in.
export ledger enrolled: Map<Bytes<32>, Uint<64>>;

/// Accounts barred by moderation. Bans survive reinstall and re-signup because
/// the key is derived from the credential, not from the device.
export ledger barred: Set<Bytes<32>>;

export ledger currentYear: Cell<Uint<16>>;
export ledger epoch: Counter;

witness credentialBirthYear(): Uint<16>;
witness credentialSubject(): Bytes<32>;
witness credentialIssuer(): Bytes<32>;
witness credentialSignature(): Bytes<64>;
witness credentialSalt(): Bytes<32>;

/// The message the issuer signed.
circuit credentialDigest(
  subject: Bytes<32>,
  birthYear: Uint<16>,
  salt: Bytes<32>
): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "halo:cred:v1"),
    subject,
    persistentHash<Uint<16>>(birthYear),
    salt
  ]);
}

/// Per-app handle. Domain separation is what keeps this unlinkable across apps
/// while staying stable inside Halo.
circuit personhoodNullifier(subject: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([
    pad(32, "halo:person:v1"),
    subject
  ]);
}

/// Enrol: prove adulthood and personhood, reveal neither age nor identity.
///
/// Public inputs:  none beyond ledger state
/// Disclosed:      one opaque, Halo-scoped handle
/// Hidden:         birth year, exact age, issuer identity, credential subject
export circuit enrol(): Bytes<32> {
  const birthYear = credentialBirthYear();
  const subject = credentialSubject();
  const issuer = credentialIssuer();
  const salt = credentialSalt();

  // 1. The credential must carry a signature from an accepted issuer.
  const digest = credentialDigest(subject, birthYear, salt);
  assert(
    verifySignature(issuer, digest, credentialSignature()),
    "credential: bad issuer signature"
  );
  assert(trustedIssuers.member(issuer), "credential: untrusted issuer");

  // 2. Age check. Only the comparison result crosses the boundary - the year
  //    itself is a witness and stays in the wallet.
  const year = currentYear;
  assert(birthYear <= year, "credential: birth year in the future");
  assert(year - birthYear >= MIN_AGE, "credential: under 18");

  // 3. One account per person, and bans stick.
  const handle = personhoodNullifier(subject);
  assert(!barred.member(handle), "credential: account barred");
  assert(!enrolled.member(handle), "credential: already enrolled");
  enrolled.insert(handle, disclose(epoch as Uint<64>));

  return disclose(handle);
}

/// Re-prove adulthood for a gated action without re-enrolling. Used when a
/// conversation escalates to voice or video.
export circuit attestAdult(): [] {
  const birthYear = credentialBirthYear();
  const subject = credentialSubject();
  const salt = credentialSalt();

  const digest = credentialDigest(subject, birthYear, salt);
  assert(
    verifySignature(credentialIssuer(), digest, credentialSignature()),
    "credential: bad issuer signature"
  );
  assert(currentYear - birthYear >= MIN_AGE, "credential: under 18");

  const handle = personhoodNullifier(subject);
  assert(enrolled.member(handle), "credential: not enrolled");
  assert(!barred.member(handle), "credential: account barred");
}

/// Moderation. Takes the handle produced by a report flow; the operator still
/// never learns who it belongs to.
export circuit bar(handle: Bytes<32>): [] {
  barred.insert(disclose(handle));
}

export circuit setYear(y: Uint<16>): [] {
  currentYear = disclose(y);
}

export circuit trustIssuer(issuer: Bytes<32>): [] {
  trustedIssuers.insert(disclose(issuer));
}
